@page "/sites"
@rendermode InteractiveServer

<PageTitle>Sites</PageTitle>

<div class="d-flex justify-content-between align-items-baseline mb-4">
    <h1 class="h3 mb-0">Sites</h1>
    <span class="small text-muted">@_slotsUsed of @Options.MaxActiveSites slots used</span>
</div>

@if (!Options.PublicRegistrationEnabled)
{
    <div class="alert alert-secondary py-2 small">
        Public registration is closed. The sites below are being monitored.
    </div>
}
else if (IsFull)
{
    <div class="alert alert-warning py-2 small">
        The demo is full (@Options.MaxActiveSites sites). Publicly added sites expire
        after @Options.DemoSiteLifetimeHours hours, so a slot will free up soon.
    </div>
}
else
{
    <EditForm Model="_newSite" OnValidSubmit="AddAsync" FormName="add-site">
        <DataAnnotationsValidator />

        <div class="row g-2 align-items-start mb-2">
            <div class="col-sm-3">
                <InputText @bind-Value="_newSite.Name" class="form-control" placeholder="Name" />
                <ValidationMessage For="() => _newSite.Name" class="small text-danger" />
            </div>
            <div class="col-sm-5">
                <InputText @bind-Value="_newSite.Url" class="form-control" placeholder="https://example.com" />
                <ValidationMessage For="() => _newSite.Url" class="small text-danger" />
            </div>
            <div class="col-sm-2">
                <InputNumber @bind-Value="_newSite.CheckIntervalMinutes" class="form-control"
                             min="@Options.MinCheckIntervalMinutes" />
                <div class="form-text">min. @Options.MinCheckIntervalMinutes</div>
            </div>
            <div class="col-sm-2">
                <button type="submit" class="btn btn-primary w-100" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Adding…" : "Add site")
                </button>
            </div>
        </div>
    </EditForm>

    <p class="small text-muted mb-4">
        Sites added here are removed automatically after @Options.DemoSiteLifetimeHours hours.
        Private and internal addresses are rejected.
    </p>
}

@if (_errorMessage is not null)
{
    <div class="alert alert-danger py-2">@_errorMessage</div>
}

@if (_sites is null)
{
    <p class="text-muted">Loading…</p>
}
else if (_sites.Count == 0)
{
    <p class="text-muted">No sites registered yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>URL</th>
                <th>Interval</th>
                <th>Expires</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var site in _sites)
            {
                <tr>
                    <td><a href="/sites/@site.Id" class="text-decoration-none">@site.Name</a></td>
                    <td class="small text-muted">@site.Url</td>
                    <td>@site.CheckIntervalMinutes min</td>
                    <td class="small text-muted">@ExpiryLabel(site)</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary"
                                disabled="@(_checkingId == site.Id)"
                                @onclick="() => CheckNowAsync(site)">
                            @(_checkingId == site.Id ? "Checking…" : "Check now")
                        </button>

                        @if (_pendingDeleteId == site.Id)
                        {
                            <button class="btn btn-sm btn-danger ms-1" @onclick="() => DeleteAsync(site)">
                                Confirm
                            </button>
                            <button class="btn btn-sm btn-link ms-1" @onclick="() => _pendingDeleteId = null">
                                Cancel
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger ms-1"
                                    @onclick="() => _pendingDeleteId = site.Id">
                                Delete
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
